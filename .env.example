# Copy this file to .env.local for repository-local development settings.
# Both listeners remain fixed to 127.0.0.1.
PI_WEB_PORT=3001
PI_WEB_DEV_PORT=5173

# Optional. Use an absolute path. If omitted, state is stored under
# ~/.pi/web-workspace/. For disposable development state, choose a temp path.
# PI_WEB_STATE_DIR=/absolute/path/to/disposable/pi-web-state

# Optional lightweight provider/model used to summarize the first prompt for
# thread and worktree names. If unavailable, naming falls back locally.
# PI_WEB_NAMING_MODEL=openai-codex/gpt-5.4-mini

# Optional. Which agent backend new chats start on when the browser has not
# chosen one in Settings. "codex" (default) or "pi". Existing chats never
# change backend.
# PI_WEB_DEFAULT_RUNTIME=codex

# Optional. The file and network boundary Codex chats run under.
# "workspace-write" (default) confines Codex to the chat's execution root with
# no network. "read-only" forbids writes. "danger-full-access" matches Pi's
# posture: the server user's full permissions. Approvals are always disabled,
# because the workspace has no surface for answering them.
# PI_WEB_CODEX_SANDBOX=workspace-write

# Optional. The Codex executable, if it is not on PATH as `codex`.
# PI_WEB_CODEX_BIN=/absolute/path/to/codex

# Optional. Codex state root containing sessions/. Defaults to CODEX_HOME and
# then ~/.codex. Must be absolute when set.
# PI_WEB_CODEX_HOME=/absolute/path/to/.codex

# Optional emergency switch for replaying historical Codex tool activity from
# Codex's private session files. "on" (default) or "off". Message history and
# live tool activity continue to work when replay is off.
# PI_WEB_CODEX_REPLAY_TOOLS=on
