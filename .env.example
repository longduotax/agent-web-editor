# Copy this file to .env.local for repository-local development settings.
# Both listeners remain fixed to 127.0.0.1.
PI_WEB_PORT=3001
PI_WEB_DEV_PORT=5173

# Optional. Use an absolute path. If omitted, state is stored under
# ~/.pi/web-workspace/. For disposable development state, choose a temp path.
# PI_WEB_STATE_DIR=/absolute/path/to/disposable/pi-web-state

# Optional lightweight provider/model used to summarize the first prompt for
# thread and worktree names. If unavailable, naming falls back locally.
# PI_WEB_NAMING_MODEL=openai-codex/gpt-5.4-mini
